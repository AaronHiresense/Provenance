# PROVENANCE - LLM configuration.  Copy this file to .env and uncomment ONE
# option. Values in .env are read at startup and WIN over ambient environment
# variables. With everything commented out, the app runs in offline mock mode
# (no key, no network - the full pipeline still works).

# --- Option A: Anthropic (or any Anthropic-compatible endpoint) ------------
# Requires: pip install anthropic
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# PROVENANCE_LLM_MODEL=claude-opus-5

# --- Option A variant: DeepSeek via its Anthropic-compatible endpoint ------
# ANTHROPIC_API_KEY=sk-your-deepseek-key
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# PROVENANCE_LLM_MODEL=deepseek-chat

# --- Option B: any OpenAI-compatible endpoint (no SDK needed) --------------
# PROVENANCE_LLM_BASE_URL=https://api.openai.com/v1
# PROVENANCE_LLM_API_KEY=your-key-here
# PROVENANCE_LLM_MODEL=gpt-5

# --- Force a provider explicitly (anthropic | openai_compat | mock) --------
# PROVENANCE_LLM_PROVIDER=mock

# --- Database (only if mca.duckdb is not in the project or parent folder) --
# PROVENANCE_DB=C:\path\to\mca.duckdb
